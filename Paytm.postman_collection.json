    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();\n\nif (pm.response.code === 200 && res.data.token) {\n    pm.collectionVariables.set(\"authToken\", res.data.token);\n} else {\n  console.warn(\"Login failed or token missing\", res);\n}\n\npm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response contains token\", function () {\n    pm.expect(res.data).to.have.property(\"token\");\n    pm.expect(res.data.token).to.be.a(\"string\").and.not.empty;\n});\n\npm.test(\"authToken collection variable is set\", function () {\n    const authToken = pm.collectionVariables.get(\"authToken\");\n    pm.expect(authToken).to.be.a(\"string\").and.not.empty;\n});\n\npm.test(\"authToken matches token from response\", function () {\n    const authToken = pm.collectionVariables.get(\"authToken\");\n    pm.expect(authToken).to.eql(res.data.token);\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"sunny\"\n}",
